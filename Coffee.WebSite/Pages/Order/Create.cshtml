@page
@model Coffee.WebSite.Pages.Order.CreateModel

@{ ViewData["Title"] = "Agregar Orden"; }

<div class="container mt-4">
    <h2>Agregar Orden</h2>
    <hr />
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div class="mb-3">
                    <label asp-for="OrderDto.UserId" class="form-label">Usuario ID</label>
                    <input asp-for="OrderDto.UserId" class="form-control" type="number" required />
                </div>
                <div class="mb-3">
                    <label asp-for="OrderDto.CustomerId" class="form-label">Cliente ID</label>
                    <input asp-for="OrderDto.CustomerId" class="form-control" type="number" />
                </div>
                <div class="mb-3">
                    <label asp-for="OrderDto.PaymentMethodId" class="form-label">Método de Pago ID</label>
                    <input asp-for="OrderDto.PaymentMethodId" class="form-control" type="number" required />
                </div>
                <div class="mb-3">
                    <label asp-for="OrderDto.Total" class="form-label">Total</label>
                    <input asp-for="OrderDto.Total" class="form-control" type="number" step="0.01" required />
                </div>
                <div class="mb-3">
                    <label asp-for="OrderDto.Status" class="form-label">Estado</label>
                    <input asp-for="OrderDto.Status" class="form-control" value="Pending" />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">Crear</button>
                    <a asp-page="./List" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
