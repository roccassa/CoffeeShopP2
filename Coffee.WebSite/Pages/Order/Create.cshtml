@page
@model Coffee.WebSite.Pages.Order.CreateModel
@{
    ViewData["Title"] = "Agregar Orden";
}

@section Styles {
    <style>
        body {
            background-color: #f8f1e9 !important;
        }

        .main-content {
            background-color: #fdfbf7;
            min-height: 100vh;
            padding-bottom: 4rem;
        }

        .page-header {
            background: linear-gradient(135deg, #2c1d11, #6f4e37);
            color: white;
            padding: 2rem 0;
            border-radius: 0 0 20px 20px;
            margin-bottom: 2.5rem;
        }

        .card-custom {
            border: none;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(44, 29, 17, 0.06);
            padding: 2.5rem;
        }

        .form-label {
            color: #2c1d11;
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .input-group-text {
            background-color: #fdfbf7;
            border-color: #e9e4dc;
            color: #6f4e37;
        }

        .form-control, .form-select {
            border-color: #e9e4dc;
            padding: 0.65rem 0.75rem;
            background-color: #fdfbf7;
            font-size: 0.95rem;
            border-radius: 8px;
        }

        .form-control:focus, .form-select:focus {
            background-color: #ffffff;
            border-color: #6f4e37;
            box-shadow: 0 0 0 0.25rem rgba(111, 78, 55, 0.15);
        }

        .btn-coffee-save {
            background-color: #6f4e37;
            border-color: #6f4e37;
            color: white;
            font-weight: 600;
            padding: 0.65rem 1.5rem;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-coffee-save:hover {
            background-color: #2c1d11;
            border-color: #2c1d11;
            color: white;
        }

        .btn-coffee-cancel {
            background-color: transparent;
            border: 1px solid #c8b195;
            color: #6f4e37;
            font-weight: 600;
            padding: 0.65rem 1.5rem;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-coffee-cancel:hover {
            background-color: #f5e8d3;
            color: #2c1d11;
            border-color: #6f4e37;
        }

        .alert-custom {
            background-color: #fdf2f2;
            border: 1px solid #fbd5d5;
            color: #9b1c1c;
            border-radius: 8px;
            font-size: 0.9rem;
        }
    </style>
}

<div class="main-content">
    <div class="page-header text-center">
        <div class="container">
            <h1 class="display-5 fw-bold">Nueva Orden Administrativa</h1>
            <p class="lead mb-0">Forza el registro o alta manual de un ticket comercial en el sistema</p>
        </div>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">
                
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-custom alert-dismissible fade show d-flex align-items-center mb-4 p-3" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                        <div>@Model.ErrorMessage</div>
                        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
                    </div>
                }

                <div class="card card-custom">
                    <form method="post" autocomplete="off" novalidate>
                        
                        <div class="mb-3">
                            <label asp-for="OrderDto.UserId" class="form-label">ID del Usuario (Cajero)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person-badge"></i></span>
                                <input asp-for="OrderDto.UserId" class="form-control" type="number" placeholder="Ingresa ID del empleado en caja" required min="1" autofocus />
                            </div>
                            <span asp-validation-for="OrderDto.UserId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OrderDto.CustomerId" class="form-label">ID del Cliente (Dejar vacío si es Público General)</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                                <input asp-for="OrderDto.CustomerId" class="form-control" type="number" placeholder="Opcional: ID de cliente fidelizado" min="1" />
                            </div>
                            <span asp-validation-for="OrderDto.CustomerId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OrderDto.PaymentMethodId" class="form-label">ID del Método de Pago</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-credit-card-2-back-fill"></i></span>
                                <input asp-for="OrderDto.PaymentMethodId" class="form-control" type="number" placeholder="Ingresa ID del método de cobro" required min="1" />
                            </div>
                            <span asp-validation-for="OrderDto.PaymentMethodId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OrderDto.Total" class="form-label">Monto Total de la Venta</label>
                            <div class="input-group">
                                <span class="input-group-text fw-bold">$</span>
                                <input asp-for="OrderDto.Total" class="form-control" type="number" step="0.01" placeholder="0.00" required min="0" />
                            </div>
                            <span asp-validation-for="OrderDto.Total" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="OrderDto.Status" class="form-label">Estado Inicial de la Orden</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-arrow-left-right"></i></span>
                                <select asp-for="OrderDto.Status" class="form-select">
                                    <option value="Pendiente" selected>Pendiente</option>
                                    <option value="Completado">Completado</option>
                                    <option value="Cancelado">Cancelado</option>
                                </select>
                            </div>
                            <span asp-validation-for="OrderDto.Status" class="text-danger small"></span>
                        </div>

                        <hr class="text-muted my-4" />

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-page="./List" class="btn btn-coffee-cancel">
                                <i class="bi bi-x-circle me-1"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-coffee-save">
                                <i class="bi bi-check-circle me-1"></i> Crear Orden
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}