@page
@model Coffee.WebSite.Pages.POS.IndexModel

@{
    ViewData["Title"] = "Menú — Punto de Venta";
    Layout = "~/Pages/Shared/_Layout.cshtml";

    // Serialize data for JavaScript
    var categoriesJson     = System.Text.Json.JsonSerializer.Serialize(Model.Categories.Select(c => new { id = c.Id, name = c.Name }));
    var productsJson       = System.Text.Json.JsonSerializer.Serialize(Model.Products.Select(p => new { id = p.Id, name = p.Name, categoryId = p.CategoryId, description = p.Description, imageUrl = p.ImageUrl }));
    var variantsJson       = System.Text.Json.JsonSerializer.Serialize(Model.Variants.Select(v => new { id = v.Id, productId = v.ProductId, size = v.Size, price = v.Price }));
    var paymentMethodsJson = System.Text.Json.JsonSerializer.Serialize(Model.PaymentMethods.Select(m => new { id = m.Id, name = m.Name }));
    var customersJson      = System.Text.Json.JsonSerializer.Serialize(Model.Customers.Select(c => new { id = c.Id, name = c.Name, email = c.Email }));
    var usersJson          = System.Text.Json.JsonSerializer.Serialize(Model.Users.Select(u => new { id = u.Id, fullName = u.FullName, username = u.Username }));
}

@section Styles {
<style>
    body { overflow: hidden; }
    @@media (max-width: 991px) { body { overflow: auto; } }

    /* POS header bar */
    .pos-bar {
        background: var(--coffee-dark);
        color: var(--cream-warm);
        padding: 0.45rem 1rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 0.82rem;
        font-weight: 600;
    }

    /* Variant selector modal */
    .variant-option {
        border: 2px solid var(--soft-gray);
        border-radius: 10px;
        padding: 0.9rem 1rem;
        cursor: pointer;
        transition: all 0.18s;
        text-align: center;
    }
    .variant-option:hover, .variant-option.selected {
        border-color: var(--coffee-medium);
        background: var(--cream-warm);
    }
    .variant-size  { font-weight: 700; font-size: 1rem; color: var(--coffee-dark); }
    .variant-price { font-size: 1.1rem; color: var(--coffee-medium); font-weight: 800; font-family: 'Courier New', monospace; }

    /* Payment modal */
    .pay-btn-option {
        border: 2px solid var(--soft-gray);
        border-radius: 10px;
        padding: 1.1rem;
        text-align: center;
        cursor: pointer;
        transition: all 0.18s;
        font-weight: 700;
        font-size: 1.05rem;
    }
    .pay-btn-option.selected { border-color: var(--coffee-medium); background: var(--cream-warm); }
    .pay-btn-option i { display: block; font-size: 1.8rem; margin-bottom: 0.4rem; }

    /* Product image in grid card */
    .pos-product-img {
        width: 72px;
        height: 72px;
        object-fit: cover;
        border-radius: 12px;
        margin-bottom: 0.4rem;
        display: block;
    }

    /* Success overlay */
    #successOverlay {
        position: fixed; inset: 0;
        background: rgba(22, 163, 74, 0.95);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        flex-direction: column;
        color: white;
        text-align: center;
        animation: fadeIn 0.3s ease;
    }
    #successOverlay.show { display: flex; }
    @@keyframes fadeIn { from { opacity:0; } to { opacity:1; } }
    .success-icon { font-size: 5rem; margin-bottom: 1rem; animation: pop 0.4s ease; }
    @@keyframes pop { from{transform:scale(0.5);opacity:0} to{transform:scale(1);opacity:1} }
</style>
}

<!-- Top POS bar -->
<div class="pos-bar no-print">
    <span><i class="bi bi-cup-hot-fill me-1"></i> Menú — @Model.CurrentUsername</span>
    <span id="pos-time" class="font-monospace"></span>
    <span>
        <button class="btn btn-sm btn-outline-warning" onclick="clearTicket()">
            <i class="bi bi-x-circle me-1"></i>Limpiar
        </button>
    </span>
</div>

<!-- Main POS layout -->
<div class="pos-wrapper">

    <!-- ① Categories sidebar -->
    <div class="pos-categories" id="categorySidebar">
        <button class="pos-category-btn active" data-cat-id="0" onclick="filterCategory(this, 0)">
            <i class="bi bi-grid-fill"></i>
            TODOS
        </button>
        @foreach (var cat in Model.Categories)
        {
            var icon = cat.Name?.ToLower() switch {
                var n when n.Contains("cafe") || n.Contains("caf") || n.Contains("coffee") => "bi-cup-hot-fill",
                var n when n.Contains("paste") || n.Contains("repo") || n.Contains("pastry") || n.Contains("pan") => "bi-cake2-fill",
                var n when n.Contains("fría") || n.Contains("fria") || n.Contains("cold") || n.Contains("bebida") => "bi-cup-straw",
                var n when n.Contains("snack") || n.Contains("botana") => "bi-basket-fill",
                _ => "bi-box-fill"
            };
            <button class="pos-category-btn" data-cat-id="@cat.Id" onclick="filterCategory(this, @cat.Id)">
                <i class="bi @icon"></i>
                @cat.Name?.ToUpper()
            </button>
        }
    </div>

    <!-- ② Products grid -->
    <div class="pos-products">
        <div class="pos-search">
            <input type="text" class="form-control form-control-sm" id="productSearch"
                   placeholder="&#xF52A; Buscar producto..." oninput="searchProducts(this.value)"
                   style="border-radius:8px;" />
        </div>
        <div class="pos-product-grid" id="productGrid">
            <!-- Populated by JS -->
        </div>
    </div>

    <!-- ③ Current Ticket -->
    <div class="pos-ticket">
        <div class="pos-ticket-header">
            <span><i class="bi bi-receipt me-1"></i> TICKET ACTUAL</span>
            <span id="ticket-count" class="badge bg-warning text-dark" style="display:none;">0</span>
        </div>
        <div class="pos-ticket-items" id="ticketItems">
            <div class="ticket-empty" id="ticketEmpty">
                <i class="bi bi-receipt display-6 d-block mb-2 opacity-50"></i>
                Esperando productos...
            </div>
        </div>
        <div class="pos-ticket-footer">
            <div class="ticket-total">
                <span>TOTAL</span>
                <span id="ticketTotal">$0.00</span>
            </div>
            <button class="btn-pay" id="btnPay" disabled onclick="openPayModal()">
                <i class="bi bi-cash-coin me-2"></i>PAGAR
            </button>
        </div>
    </div>
</div>

<!-- === VARIANT SELECTOR MODAL === -->
<div class="modal fade" id="variantModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-sm">
        <div class="modal-content" style="border-radius:14px; overflow:hidden;">
            <div class="modal-header" style="background:var(--coffee-dark); color:var(--cream-warm); border:none;">
                <h6 class="modal-title fw-bold" id="variantModalTitle">Seleccionar Tamaño</h6>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-3" id="variantModalBody">
                <!-- JS populated -->
            </div>
        </div>
    </div>
</div>

<!-- === PAYMENT MODAL === -->
<div class="modal fade" id="payModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" style="border-radius:16px; overflow:hidden;">
            <div class="modal-header" style="background:var(--coffee-dark); color:var(--cream-warm); border:none;">
                <h5 class="modal-title fw-bold"><i class="bi bi-cash-coin me-2"></i>Procesar Pago</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <!-- Order summary -->
                <div id="payOrderSummary" class="mb-3 p-3" style="background:var(--cream-warm); border-radius:10px; font-size:0.88rem;">
                </div>

                <!-- Cashier (user) -->
                <div class="mb-3">
                    <label class="form-label fw-bold mb-1">
                        <i class="bi bi-person-badge me-1"></i>Cajero / Empleado
                    </label>
                    <select class="form-select form-select-sm" id="selectUser">
                        <!-- Populated by JS -->
                    </select>
                </div>

                <!-- Customer (optional) -->
                <div class="mb-3">
                    <label class="form-label fw-bold mb-1">
                        <i class="bi bi-person me-1"></i>Cliente
                        <span class="text-muted fw-normal small">(opcional)</span>
                    </label>
                    <select class="form-select form-select-sm" id="selectCustomer">
                        <option value="0">— Sin cliente registrado —</option>
                        <!-- Populated by JS -->
                    </select>
                </div>

                <!-- Payment method -->
                <label class="form-label fw-bold mb-2">Método de pago</label>
                <div class="row g-2 mb-3" id="payMethodGrid">
                    <!-- JS populated -->
                </div>

                <!-- Cash received (shown only for cash) -->
                <div id="cashSection" style="display:none;">
                    <label class="form-label fw-bold">Efectivo recibido</label>
                    <div class="input-group mb-2">
                        <span class="input-group-text">$</span>
                        <input type="number" class="form-control" id="cashReceived"
                               min="0" step="0.50" placeholder="0.00" oninput="calcChange()" />
                    </div>
                    <div id="changeDisplay" class="p-2 rounded text-center fw-bold"
                         style="background:#dcfce7; color:#15803d; display:none;">
                        Cambio: $<span id="changeAmount">0.00</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top:1px solid var(--soft-gray);">
                <button class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button class="btn btn-coffee" id="btnConfirmPay" onclick="confirmPayment()">
                    <i class="bi bi-check-circle me-1"></i>Confirmar Pago
                </button>
            </div>
        </div>
    </div>
</div>

<!-- === SUCCESS OVERLAY === -->
<div id="successOverlay">
    <div class="success-icon">✓</div>
    <h2 class="fw-bold mb-1">¡Venta Exitosa!</h2>
    <p class="fs-5 mb-3">Orden <span id="successOrderId">#0</span> registrada</p>
    <div class="d-flex gap-3 justify-content-center flex-wrap">
        <button class="btn btn-light fw-bold px-4" onclick="printLastTicket()">
            <i class="bi bi-printer me-2"></i>Imprimir Ticket
        </button>
        <button class="btn btn-outline-light fw-bold px-4" onclick="closeSuccess()">
            <i class="bi bi-plus-circle me-2"></i>Nueva Venta
        </button>
    </div>
</div>

<!-- Hidden ticket for printing -->
<div id="printTicketArea" style="display:none; position:fixed; inset:0; z-index:99999; background:#fff; padding:2rem;">
</div>

@section Scripts {
<script>
// === DATA FROM SERVER ===
const CATEGORIES      = @Html.Raw(categoriesJson);
const PRODUCTS        = @Html.Raw(productsJson);
const VARIANTS        = @Html.Raw(variantsJson);
const PAYMENT_METHODS = @Html.Raw(paymentMethodsJson);
const CUSTOMERS       = @Html.Raw(customersJson);
const USERS           = @Html.Raw(usersJson);
const SESSION_USER_ID = @Model.CurrentUserId;

// === TICKET STATE ===
let ticket = [];          // [{variantId, productName, size, unitPrice, qty}]
let selectedPayMethod = null;
let lastOrderId = null;

// === CATEGORY ICONS (client-side) ===
function categoryIcon(catName) {
    const n = (catName || '').toLowerCase();
    if (n.includes('cafe') || n.includes('caf') || n.includes('coffee')) return '☕';
    if (n.includes('paste') || n.includes('repo') || n.includes('pastry') || n.includes('pan') || n.includes('cake')) return '🥐';
    if (n.includes('fría') || n.includes('fria') || n.includes('cold') || n.includes('bebida')) return '🧊';
    if (n.includes('snack') || n.includes('botana')) return '🫙';
    return '🍽️';
}
function productEmoji(name, catName) {
    const n = (name || '').toLowerCase();
    const c = (catName || '').toLowerCase();
    if (n.includes('latte') || n.includes('capuchino') || n.includes('cappuccino')) return '☕';
    if (n.includes('americano')) return '☕';
    if (n.includes('espresso') || n.includes('expreso')) return '☕';
    if (n.includes('mocha') || n.includes('moka')) return '☕';
    if (n.includes('cold brew') || n.includes('cold-brew')) return '🧊';
    if (n.includes('frapé') || n.includes('frape') || n.includes('frappe')) return '🥤';
    if (n.includes('chocolate')) return '🍫';
    if (n.includes('té') || n.includes('te ') || n.includes(' tea')) return '🍵';
    if (n.includes('croissant')) return '🥐';
    if (n.includes('muffin')) return '🧁';
    if (n.includes('dona') || n.includes('donut')) return '🍩';
    if (n.includes('pan') || n.includes('bread')) return '🍞';
    if (n.includes('galleta') || n.includes('cookie')) return '🍪';
    if (n.includes('pasta') || n.includes('cake') || n.includes('pastel')) return '🎂';
    if (c.includes('cold') || c.includes('fría')) return '🧊';
    if (c.includes('snack') || c.includes('botana')) return '🫙';
    return '☕';
}

// === RENDER PRODUCTS ===
let currentCatId = 0;
let currentSearch = '';

function renderProducts() {
    const grid = document.getElementById('productGrid');
    grid.innerHTML = '';

    try {
    let filtered = PRODUCTS;
    if (currentCatId > 0)    filtered = filtered.filter(p => p.categoryId === currentCatId);
    if (currentSearch)        filtered = filtered.filter(p => (p.name || '').toLowerCase().includes(currentSearch.toLowerCase()));

    if (filtered.length === 0) {
        grid.innerHTML = `<div class="col-12 text-center text-muted py-4 opacity-75">
            <i class="bi bi-search fs-2 d-block mb-2"></i>Sin productos en esta categoría</div>`;
        return;
    }

    filtered.forEach(p => {
        const pVariants = VARIANTS.filter(v => v.productId === p.id);
        const minPrice  = pVariants.length ? Math.min(...pVariants.map(v => v.price)) : 0;
        const cat       = CATEGORIES.find(c => c.id === p.categoryId);
        const emoji     = productEmoji(p.name, cat?.name);

        const priceLabel = pVariants.length > 1
            ? `Desde $${minPrice.toFixed(2)}`
            : pVariants.length === 1 ? `$${pVariants[0].price.toFixed(2)}` : 'Sin precio';

        const imgHtml = p.imageUrl
            ? `<img src="${p.imageUrl}" class="pos-product-img" alt="${p.name}"
                    onerror="this.style.display='none';this.nextElementSibling.style.display='block'">
               <div class="pos-product-icon" style="display:none">${emoji}</div>`
            : `<div class="pos-product-icon">${emoji}</div>`;

        const card = document.createElement('div');
        card.className = 'pos-product-card';
        card.innerHTML = `
            ${imgHtml}
            <div class="pos-product-name">${p.name}</div>
            <div class="pos-product-from">${priceLabel}</div>`;
        card.onclick = () => selectProduct(p, pVariants);
        grid.appendChild(card);
    });
    } catch(e) {
        grid.innerHTML = `<div class="col-12 text-center text-danger py-4">
            <i class="bi bi-exclamation-triangle fs-2 d-block mb-2"></i>Error al cargar productos: ${e.message}</div>`;
    }
}

function filterCategory(btn, catId) {
    document.querySelectorAll('.pos-category-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    currentCatId = catId;
    currentSearch = '';
    document.getElementById('productSearch').value = '';
    renderProducts();
}

function searchProducts(val) {
    currentSearch = val;
    currentCatId  = 0;
    document.querySelectorAll('.pos-category-btn').forEach(b => b.classList.remove('active'));
    document.querySelector('[data-cat-id="0"]').classList.add('active');
    renderProducts();
}

// === VARIANT SELECTION ===
function selectProduct(product, variants) {
    if (variants.length === 0) { alert('Este producto no tiene presentaciones configuradas.'); return; }

    if (variants.length === 1) {
        addToTicket(product.name, variants[0]);
        return;
    }

    // Show modal to pick variant
    document.getElementById('variantModalTitle').textContent = product.name;
    const body = document.getElementById('variantModalBody');
    body.innerHTML = `<div class="row g-2">
        ${variants.map(v => `
        <div class="col-6">
            <div class="variant-option" onclick="pickVariant(this, '${product.name}', ${v.id}, ${v.price}, '${v.size}')">
                <div class="variant-size">${v.size}</div>
                <div class="variant-price">$${v.price.toFixed(2)}</div>
            </div>
        </div>`).join('')}
    </div>
    <button class="btn btn-coffee w-100 mt-3" id="addVariantBtn" style="display:none;" onclick="addSelectedVariant()">
        <i class="bi bi-plus-circle me-1"></i>Agregar al Ticket
    </button>`;

    new bootstrap.Modal(document.getElementById('variantModal')).show();
}

let _pendingVariant = null;
function pickVariant(el, productName, variantId, price, size) {
    document.querySelectorAll('.variant-option').forEach(e => e.classList.remove('selected'));
    el.classList.add('selected');
    _pendingVariant = { productName, variantId, price, size };
    document.getElementById('addVariantBtn').style.display = 'block';
}
function addSelectedVariant() {
    if (!_pendingVariant) return;
    const v = { id: _pendingVariant.variantId, price: _pendingVariant.price, size: _pendingVariant.size };
    addToTicket(_pendingVariant.productName, v);
    bootstrap.Modal.getInstance(document.getElementById('variantModal')).hide();
    _pendingVariant = null;
}

// === TICKET MANAGEMENT ===
function addToTicket(productName, variant) {
    const existing = ticket.find(i => i.variantId === variant.id);
    if (existing) {
        existing.qty++;
    } else {
        ticket.push({ variantId: variant.id, productName, size: variant.size, unitPrice: variant.price, qty: 1 });
    }
    renderTicket();
}

function changeQty(variantId, delta) {
    const item = ticket.find(i => i.variantId === variantId);
    if (!item) return;
    item.qty += delta;
    if (item.qty <= 0) ticket = ticket.filter(i => i.variantId !== variantId);
    renderTicket();
}

function removeItem(variantId) {
    ticket = ticket.filter(i => i.variantId !== variantId);
    renderTicket();
}

function clearTicket() {
    ticket = [];
    renderTicket();
}

function renderTicket() {
    const container = document.getElementById('ticketItems');
    const empty     = document.getElementById('ticketEmpty');
    const totalEl   = document.getElementById('ticketTotal');
    const btnPay    = document.getElementById('btnPay');
    const countBadge = document.getElementById('ticket-count');

    container.querySelectorAll('.ticket-item').forEach(e => e.remove());

    if (ticket.length === 0) {
        empty.style.display = '';
        totalEl.textContent = '$0.00';
        btnPay.disabled = true;
        countBadge.style.display = 'none';
        return;
    }

    empty.style.display = 'none';
    let total = 0;

    ticket.forEach(item => {
        const subtotal = item.unitPrice * item.qty;
        total += subtotal;
        const row = document.createElement('div');
        row.className = 'ticket-item';
        row.innerHTML = `
            <div class="ticket-item-name">
                ${item.productName}
                <small>${item.size}</small>
            </div>
            <div class="ticket-item-controls">
                <button class="ti-btn" onclick="changeQty(${item.variantId},-1)">−</button>
                <span class="ticket-item-qty">${item.qty}</span>
                <button class="ti-btn" onclick="changeQty(${item.variantId},1)">+</button>
            </div>
            <div class="ticket-item-price">$${subtotal.toFixed(2)}</div>
            <button class="ticket-item-remove" onclick="removeItem(${item.variantId})" title="Eliminar">
                <i class="bi bi-x-lg"></i>
            </button>`;
        container.appendChild(row);
    });

    totalEl.textContent = '$' + total.toFixed(2);
    btnPay.disabled = false;
    countBadge.textContent = ticket.reduce((s, i) => s + i.qty, 0);
    countBadge.style.display = '';
}

// === PAYMENT ===
function openPayModal() {
    if (ticket.length === 0) return;

    // Summary
    const total = ticket.reduce((s, i) => s + i.unitPrice * i.qty, 0);
    const summaryEl = document.getElementById('payOrderSummary');
    summaryEl.innerHTML = ticket.map(i =>
        `<div class="d-flex justify-content-between"><span>${i.qty}x ${i.productName} (${i.size})</span>
         <strong>$${(i.unitPrice * i.qty).toFixed(2)}</strong></div>`
    ).join('') + `<div class="d-flex justify-content-between mt-2 pt-2 border-top fw-bold fs-6">
        <span>TOTAL</span><span>$${total.toFixed(2)}</span></div>`;

    // Users select
    const userSel = document.getElementById('selectUser');
    userSel.innerHTML = USERS.map(u =>
        `<option value="${u.id}" ${u.id === SESSION_USER_ID ? 'selected' : ''}>
            ${u.fullName || u.username}
         </option>`
    ).join('');

    // Customers select
    const custSel = document.getElementById('selectCustomer');
    custSel.innerHTML = '<option value="0">— Sin cliente registrado —</option>' +
        CUSTOMERS.map(c =>
            `<option value="${c.id}">${c.name}${c.email ? ' · ' + c.email : ''}</option>`
        ).join('');

    // Payment methods
    const grid = document.getElementById('payMethodGrid');
    selectedPayMethod = null;
    document.getElementById('cashSection').style.display = 'none';
    grid.innerHTML = PAYMENT_METHODS.map(m => {
        const icon  = m.name.toLowerCase().includes('tarjeta') || m.name.toLowerCase().includes('card') ? 'bi-credit-card-fill' :
                      m.name.toLowerCase().includes('efectivo') || m.name.toLowerCase().includes('cash') ? 'bi-cash-stack' : 'bi-wallet-fill';
        return `<div class="col-6 col-md-4">
            <div class="pay-btn-option" onclick="selectPayMethod(this,${m.id},'${m.name}')">
                <i class="bi ${icon}"></i>${m.name}
            </div>
        </div>`;
    }).join('');

    new bootstrap.Modal(document.getElementById('payModal')).show();
}

function selectPayMethod(el, id, name) {
    document.querySelectorAll('.pay-btn-option').forEach(e => e.classList.remove('selected'));
    el.classList.add('selected');
    selectedPayMethod = id;
    const isCash = name.toLowerCase().includes('efectivo') || name.toLowerCase().includes('cash');
    document.getElementById('cashSection').style.display = isCash ? '' : 'none';
    if (isCash) { document.getElementById('cashReceived').value = ''; document.getElementById('changeDisplay').style.display = 'none'; }
}

function calcChange() {
    const total    = ticket.reduce((s,i) => s + i.unitPrice * i.qty, 0);
    const received = parseFloat(document.getElementById('cashReceived').value) || 0;
    const change   = received - total;
    const el       = document.getElementById('changeDisplay');
    if (received > 0) {
        document.getElementById('changeAmount').textContent = Math.max(0, change).toFixed(2);
        el.style.display = '';
        el.style.background = change < 0 ? '#fee2e2' : '#dcfce7';
        el.style.color = change < 0 ? '#b91c1c' : '#15803d';
    } else {
        el.style.display = 'none';
    }
}

async function confirmPayment() {
    if (!selectedPayMethod) { alert('Selecciona un método de pago.'); return; }
    const total = ticket.reduce((s,i) => s + i.unitPrice * i.qty, 0);

    const payload = {
        paymentMethodId: selectedPayMethod,
        userId:     parseInt(document.getElementById('selectUser').value)     || 0,
        customerId: parseInt(document.getElementById('selectCustomer').value) || 0,
        total,
        items: ticket.map(i => ({
            variantId:   i.variantId,
            quantity:    i.qty,
            unitPrice:   i.unitPrice,
            productName: i.productName,
            size:        i.size
        }))
    };

    const btn = document.getElementById('btnConfirmPay');
    btn.disabled = true;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Procesando...';

    try {
        const res  = await fetch('/POS/Index?handler=Checkout', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await res.json();

        if (data.success) {
            lastOrderId = data.orderId;
            bootstrap.Modal.getInstance(document.getElementById('payModal')).hide();
            showSuccess(data.orderId);
        } else {
            alert('Error: ' + data.message);
        }
    } catch (e) {
        alert('Error de comunicación: ' + e.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="bi bi-check-circle me-1"></i>Confirmar Pago';
    }
}

function showSuccess(orderId) {
    document.getElementById('successOrderId').textContent = '#' + orderId;
    document.getElementById('successOverlay').classList.add('show');
}

function closeSuccess() {
    document.getElementById('successOverlay').classList.remove('show');
    clearTicket();
}

// === PRINT TICKET ===
function printLastTicket() {
    if (!lastOrderId) return;
    const total  = ticket.reduce((s,i) => s + i.unitPrice * i.qty, 0);
    const subtotal = total / 1.16;
    const tax      = total - subtotal;
    const now = new Date();
    const dateStr = now.toLocaleDateString('es-MX') + ' ' + now.toLocaleTimeString('es-MX', {hour:'2-digit',minute:'2-digit'});

    const html = `
    <div style="font-family:'Courier New',monospace; max-width:350px; margin:0 auto; padding:1rem;">
        <div style="text-align:center; border-bottom:2px dashed #ccc; padding-bottom:1rem; margin-bottom:1rem;">
            <div style="font-size:2rem;">☕</div>
            <h2 style="font-size:1.2rem; margin:0.3rem 0;">CAFETERÍA CONTROL</h2>
            <div style="font-size:0.8rem; color:#666;">Sistema de Punto de Venta</div>
            <div style="font-size:0.78rem; margin-top:0.4rem;">${dateStr}</div>
            <div style="font-weight:bold;">Orden #${lastOrderId}</div>
        </div>
        ${ticket.map(i => `
        <div style="display:flex;justify-content:space-between;margin-bottom:0.35rem;font-size:0.9rem;">
            <span>${i.qty}x ${i.productName} (${i.size})</span>
            <span>$${(i.unitPrice*i.qty).toFixed(2)}</span>
        </div>`).join('')}
        <div style="border-top:2px dashed #ccc; margin:0.75rem 0; padding-top:0.75rem;">
            <div style="display:flex;justify-content:space-between;font-size:0.85rem;">
                <span>Subtotal</span><span>$${subtotal.toFixed(2)}</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-size:0.85rem;">
                <span>IVA (16%)</span><span>$${tax.toFixed(2)}</span>
            </div>
            <div style="display:flex;justify-content:space-between;font-weight:800;font-size:1.1rem;margin-top:0.4rem;">
                <span>TOTAL</span><span>$${total.toFixed(2)}</span>
            </div>
        </div>
        <div style="text-align:center; font-size:0.78rem; color:#666; margin-top:1rem;">
            ¡Gracias por su preferencia!<br>Vuelva pronto 🙏
        </div>
    </div>`;

    const printArea = document.getElementById('printTicketArea');
    printArea.innerHTML = html;
    printArea.style.display = 'block';
    setTimeout(() => {
        window.print();
        printArea.style.display = 'none';
    }, 200);
}

// === CLOCK ===
function updateClock() {
    const el = document.getElementById('pos-time');
    if (el) el.textContent = new Date().toLocaleTimeString('es-MX', {hour:'2-digit',minute:'2-digit',second:'2-digit'});
}
setInterval(updateClock, 1000);
updateClock();

// === INIT ===
renderProducts();
</script>
}
