@page
@model Coffee.WebSite.Pages.User.ListModel

@{
    ViewData["Title"] = "Listado de Usuarios";
}

@section Styles {
    <style>
        body {
            background-color: #f8f1e9 !important; /* Color crema principal */
        }

        .main-content {
            background-color: #fdfbf7;
            min-height: 100vh;
            padding-bottom: 3rem;
        }

        .page-header {
            background: linear-gradient(135deg, #2c1d11, #6f4e37);
            color: white;
            padding: 2rem 0;
            border-radius: 0 0 20px 20px;
            margin-bottom: 2rem;
        }

        .card {
            border: none;
            box-shadow: 0 10px 30px rgba(44, 29, 17, 0.08);
        }

        .table thead {
            background-color: #2c1d11;
            color: #f5e8d3;
        }

        .btn-success {
            background-color: #6f4e37;
            border-color: #6f4e37;
        }

        .btn-success:hover {
            background-color: #2c1d11;
            border-color: #2c1d11;
        }
    </style>
}

<div class="main-content">
    <!-- Header elegante -->
    <div class="page-header text-center">
        <div class="container">
            <h1 class="display-5 fw-bold">Gestión de Usuarios</h1>
            <p class="lead mb-0">Administra el equipo de la cafetería</p>
        </div>
    </div>

    <div class="container">
        <!-- Formulario de búsqueda -->
        <form method="get" class="mb-4">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text" name="searchTerm" value="@Model.SearchTerm"
                               class="form-control" 
                               placeholder="Buscar por username, nombre o ID..." />
                        <button class="btn btn-primary" style="background-color:#2c1d11; border:none;">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                    </div>
                </div>
                <div class="col-md-4">
                    <a asp-page="./Create" class="btn btn-success">
                        <i class="bi bi-plus-lg"></i> Agregar Nuevo Usuario
                    </a>
                </div>
            </div>
        </form>

        <!-- Tabla -->
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4">ID</th>
                            <th>Username</th>
                            <th>Nombre Completo</th>
                            <th>Rol</th>
                            <th class="text-end pe-4">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.Users != null && Model.Users.Any())
                    {
                        @foreach (var user in Model.Users)
                        {
                            <tr>
                                <td class="ps-4 fw-bold">@user.Id</td>
                                <td class="fw-bold">@user.Username</td>
                                <td>@user.FullName</td>
                                <td>
                                    <span class="badge bg-dark">@user.RoleName</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-page="./Update" asp-route-id="@user.Id" 
                                       class="btn btn-warning btn-sm me-2">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <button class="btn btn-danger btn-sm" 
                                            onclick="deleteUser(@user.Id)">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                No se encontraron usuarios.
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteUser(id) {
            if (!confirm("¿Estás seguro de eliminar este usuario? Esta acción no se puede deshacer.")) 
                return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            fetch(`/User/List?handler=Delete&id=${id}`, {
                method: 'POST',
                headers: { 
                    'RequestVerificationToken': token ?? ''
                }
            })
            .then(r => { 
                if (!r.ok) throw new Error("Error del servidor"); 
                return r.json(); 
            })
            .then(result => {
                if (result === true || result.success === true || result === "true") {
                    alert("✅ Usuario eliminado correctamente");
                    location.reload();
                } else {
                    alert("❌ Error al eliminar el usuario");
                }
            })
            .catch(e => {
                console.error(e);
                alert("Error al procesar la solicitud");
            });
        }
    </script>
}