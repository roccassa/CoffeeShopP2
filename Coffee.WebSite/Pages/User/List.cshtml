@page
@model Coffee.WebSite.Pages.User.ListModel

<div class="container-fluid mt-4">
    <h2 class="mb-4">Listado de Usuarios</h2>
    <form method="get" class="mb-4">
        @Html.AntiForgeryToken()
        <div class="row g-3 align-items-center">
            <div class="col-md-6">
                <input type="text" name="searchTerm" value="@Model.SearchTerm"
                       class="form-control" placeholder="Buscar por username o nombre..." />
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary me-2">Buscar</button>
                <a asp-page="./Create" class="btn btn-success">Agregar Nuevo</a>
            </div>
        </div>
    </form>
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Username</th>
                        <th>Nombre Completo</th>
                        <th>Rol ID</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.Users != null && Model.Users.Any())
                {
                    @foreach (var user in Model.Users)
                    {
                        <tr>
                            <td class="ps-4">@user.Id</td>
                            <td class="fw-bold">@user.Username</td>
                            <td>@user.FullName</td>
                            <td>@user.RoleId</td>
                            <td class="text-end pe-4">
                                <a asp-page="./Update" asp-route-id="@user.Id" class="btn btn-warning btn-sm me-1">Editar</a>
                                <button class="btn btn-danger btn-sm" onclick="deleteUser(@user.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-muted py-4">No se encontraron usuarios.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteUser(id) {
            if (!confirm("¿Deseas eliminar este usuario?")) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            fetch(`/User/List?handler=Delete&id=${id}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token ?? '' }
            })
            .then(r => { if (!r.ok) throw new Error(r.status); return r.json(); })
            .then(result => {
                if (result === true) { alert("Usuario eliminado correctamente"); location.reload(); }
                else { alert("Error al eliminar el usuario"); }
            })
            .catch(e => alert("Error: " + e.message));
        }
    </script>
}
