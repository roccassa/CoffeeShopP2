@page
@model Coffee.WebSite.Pages.User.CreateModel
@{
    ViewData["Title"] = "Agregar Usuario";
}

@section Styles {
    <style>
        body {
            background-color: #f8f1e9 !important; /* Color crema principal */
        }

        .main-content {
            background-color: #fdfbf7;
            min-height: 100vh;
            padding-bottom: 4rem;
        }

        .page-header {
            background: linear-gradient(135deg, #2c1d11, #6f4e37);
            color: white;
            padding: 2rem 0;
            border-radius: 0 0 20px 20px;
            margin-bottom: 2.5rem;
        }

        .card-custom {
            border: none;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(44, 29, 17, 0.06);
            padding: 2.5rem;
        }

        .form-label {
            color: #2c1d11;
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .input-group-text {
            background-color: #fdfbf7;
            border-color: #e9e4dc;
            color: #6f4e37;
        }

        .form-control, .form-select {
            border-color: #e9e4dc;
            padding: 0.65rem 0.75rem;
            background-color: #fdfbf7;
            font-size: 0.95rem;
            border-radius: 8px;
        }

        .form-control:focus, .form-select:focus {
            background-color: #ffffff;
            border-color: #6f4e37;
            box-shadow: 0 0 0 0.25rem rgba(111, 78, 55, 0.15);
        }

        /* Botones integrados a la identidad */
        .btn-coffee-save {
            background-color: #6f4e37;
            border-color: #6f4e37;
            color: white;
            font-weight: 600;
            padding: 0.65rem 1.5rem;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-coffee-save:hover {
            background-color: #2c1d11;
            border-color: #2c1d11;
            color: white;
        }

        .btn-coffee-cancel {
            background-color: transparent;
            border: 1px solid #c8b195;
            color: #6f4e37;
            font-weight: 600;
            padding: 0.65rem 1.5rem;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-coffee-cancel:hover {
            background-color: #f5e8d3;
            color: #2c1d11;
            border-color: #6f4e37;
        }

        .alert-custom {
            background-color: #fdf2f2;
            border: 1px solid #fbd5d5;
            color: #9b1c1c;
            border-radius: 8px;
            font-size: 0.9rem;
        }
    </style>
}

<div class="main-content">
    <div class="page-header text-center">
        <div class="container">
            <h1 class="display-5 fw-bold">Nuevo Colaborador</h1>
            <p class="lead mb-0">Registra una nueva cuenta de acceso al panel</p>
        </div>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-custom d-flex align-items-center mb-4 p-3" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                        <div>@Model.ErrorMessage</div>
                    </div>
                }

                <div class="card card-custom">
                    <form method="post" autocomplete="off">
                        
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="UserDto.FullName" class="form-label">Nombre Completo</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                                    <input asp-for="UserDto.FullName" class="form-control" placeholder="ej: Giovani Dos Santos" required />
                                </div>
                                <span asp-validation-for="UserDto.FullName" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="UserDto.Username" class="form-label">Nombre de Usuario (Login)</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-person-badge-fill"></i></span>
                                    <input asp-for="UserDto.Username" class="form-control" placeholder="ej: gio_barista" required />
                                </div>
                                <span asp-validation-for="UserDto.Username" class="text-danger small"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="UserDto.RoleId" class="form-label">Rol asignado</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-briefcase"></i></span>
                                    <select asp-for="UserDto.RoleId" class="form-select" 
                                            asp-items="@(new SelectList(Model.RolesList, "Id", "Name"))" required>
                                        <option value="" selected disabled>-- Seleccione Rol --</option>
                                    </select>
                                </div>  
                                <span asp-validation-for="UserDto.RoleId" class="text-danger small"></span>
                            </div>

                            <div class="col-12 mb-2">
                                <label asp-for="UserDto.PasswordHash" class="form-label">Contraseña de acceso</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                                    <input asp-for="UserDto.PasswordHash" class="form-control" type="password" placeholder="••••••••" required />
                                </div>
                                <span asp-validation-for="UserDto.PasswordHash" class="text-danger small"></span>
                            </div>
                        </div>

                        <hr class="text-muted my-4" />

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-page="./List" class="btn btn-coffee-cancel">
                                <i class="bi bi-x-circle me-1"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-coffee-save">
                                <i class="bi bi-check-circle me-1"></i> Guardar Usuario
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}