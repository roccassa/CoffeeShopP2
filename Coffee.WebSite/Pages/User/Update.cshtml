@page "{id:int}"
@model Coffee.WebSite.Pages.User.UpdateModel
@{
    ViewData["Title"] = "Editar Colaborador";
}

<div class="page-header">
    <div class="container">
        <h1 class="fw-bold mb-0 fs-4"><i class="bi bi-person-gear me-2"></i>Editar Colaborador</h1>
        <p class="mb-0 opacity-75 small">Actualiza los datos y permisos de la cuenta seleccionada</p>
    </div>
</div>

<div class="container" style="padding-bottom:3rem;">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert-form-error d-flex align-items-center gap-2 p-3 mb-3">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <div class="form-card">
                <form method="post" autocomplete="off">
                    <input type="hidden" asp-for="UserDto.Id" />

                    <!-- Nombre completo -->
                    <div class="mb-3">
                        <label class="form-label">Nombre Completo</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-card-text"></i></span>
                            <input asp-for="UserDto.FullName" class="form-control"
                                   placeholder="ej: Juan Pérez Gómez" required autofocus />
                        </div>
                        <span asp-validation-for="UserDto.FullName" class="text-danger small"></span>
                    </div>

                    <!-- Username -->
                    <div class="mb-3">
                        <label class="form-label">Nombre de Usuario (Login)</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-person-badge-fill"></i></span>
                            <input asp-for="UserDto.Username" class="form-control"
                                   placeholder="ej: juan.barista" required />
                        </div>
                        <span asp-validation-for="UserDto.Username" class="text-danger small"></span>
                    </div>

                    <!-- Rol (dropdown dinámico) -->
                    <div class="mb-3">
                        <label class="form-label">Rol Asignado</label>
                        <select asp-for="UserDto.RoleId" class="form-select" required>
                            <option value="">— Selecciona un rol —</option>
                            @foreach (var role in Model.Roles)
                            {
                                <option value="@role.Id">@role.Name</option>
                            }
                        </select>
                        <span asp-validation-for="UserDto.RoleId" class="text-danger small"></span>
                    </div>

                    <!-- Contraseña -->
                    <div class="mb-4">
                        <label class="form-label">Nueva Contraseña <small class="text-muted fw-normal">(o reescribe la actual)</small></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                            <input asp-for="UserDto.PasswordHash" class="form-control"
                                   type="password" placeholder="••••••••" required />
                        </div>
                        <span asp-validation-for="UserDto.PasswordHash" class="text-danger small"></span>
                    </div>

                    <hr class="my-3" />
                    <div class="d-flex justify-content-end gap-3">
                        <a asp-page="./List" class="btn-form-cancel btn">
                            <i class="bi bi-x-circle me-1"></i>Cancelar
                        </a>
                        <button type="submit" class="btn-form-update btn">
                            <i class="bi bi-save me-1"></i>Guardar Cambios
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}
