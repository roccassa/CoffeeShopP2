@page
@model Coffee.WebSite.Pages.Product.ListModel
@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="page-header">
    <div class="container d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="fw-bold mb-0 fs-4"><i class="bi bi-cup-hot-fill me-2"></i>Catálogo de Productos</h1>
            <p class="mb-0 opacity-75 small">Administra las bebidas, repostería y artículos disponibles en el menú</p>
        </div>
        <a asp-page="./Create" class="btn-form-save btn">
            <i class="bi bi-plus-circle me-1"></i>Nuevo Producto
        </a>
    </div>
</div>

<div class="container" style="padding-bottom:3rem;">

    <!-- Search bar -->
    <form method="get" class="mb-4">
        <div class="input-group" style="max-width:420px;">
            <span class="input-group-text" style="background:var(--cream-warm); border-color:var(--soft-gray);">
                <i class="bi bi-search text-muted"></i>
            </span>
            <input type="text" name="searchTerm" value="@Model.SearchTerm"
                   class="form-control" placeholder="Buscar por nombre o ID…"
                   style="border-color:var(--soft-gray); background:var(--cream);" />
            <button class="btn" style="background:var(--coffee-dark); color:#fff; border:none;">Buscar</button>
        </div>
    </form>

    @if (Model.Products.Any())
    {
        <div class="row g-3">
            @foreach (var p in Model.Products)
            {
                var variants = Model.VariantsByProduct.GetValueOrDefault(p.Id) ?? new();
                <div class="col-12">
                    <div class="form-card d-flex align-items-start gap-3 py-3 px-4">

                        <!-- Imagen / ícono -->
                        <div style="flex-shrink:0;">
                            @if (!string.IsNullOrEmpty(p.ImageUrl))
                            {
                                <img src="@p.ImageUrl" alt="@p.Name"
                                     style="width:60px;height:60px;object-fit:cover;border-radius:12px;" />
                            }
                            else
                            {
                                <div style="width:60px;height:60px;border-radius:12px;background:var(--cream-warm);
                                            display:flex;align-items:center;justify-content:center;font-size:1.8rem;">
                                    ☕
                                </div>
                            }
                        </div>

                        <!-- Info -->
                        <div style="flex:1; min-width:0;">
                            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                <span class="fw-bold" style="color:var(--coffee-dark); font-size:1rem;">@p.Name</span>
                                <span class="badge" style="background:var(--coffee-medium); font-size:0.7rem;">@p.CategoryName</span>
                                @if (p.IsActive)
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle" style="font-size:0.7rem;">Activo</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger border border-danger-subtle" style="font-size:0.7rem;">Inactivo</span>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(p.Description))
                            {
                                <p class="text-muted small mb-2" style="margin:0 0 0.4rem;">@p.Description</p>
                            }

                            <!-- Variantes / precios -->
                            <div class="d-flex flex-wrap align-items-center gap-2">
                                @if (variants.Any())
                                {
                                    @foreach (var v in variants)
                                    {
                                        <span class="badge"
                                              style="background:var(--cream-warm);color:var(--coffee-dark);
                                                     border:1px solid var(--soft-gray);font-weight:600;font-size:0.78rem;padding:0.35rem 0.7rem;">
                                            @v.Size · $@v.Price.ToString("F2")
                                        </span>
                                    }
                                    <a asp-page="/ProductVariant/Create" asp-route-productId="@p.Id"
                                       class="badge text-decoration-none"
                                       style="background:transparent;border:1px dashed var(--coffee-medium);
                                              color:var(--coffee-medium);font-size:0.78rem;padding:0.35rem 0.7rem;">
                                        <i class="bi bi-plus"></i> Precio
                                    </a>
                                }
                                else
                                {
                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle" style="font-size:0.75rem;">
                                        <i class="bi bi-exclamation-circle me-1"></i>Sin presentaciones
                                    </span>
                                    <a asp-page="/ProductVariant/Create" asp-route-productId="@p.Id"
                                       class="btn btn-sm"
                                       style="background:var(--coffee-medium);color:#fff;font-size:0.78rem;padding:0.25rem 0.7rem;border-radius:6px;">
                                        <i class="bi bi-plus-circle me-1"></i>Agregar precio
                                    </a>
                                }
                            </div>
                        </div>

                        <!-- Acciones -->
                        <div class="d-flex gap-2 flex-shrink-0 align-items-center">
                            <a asp-page="./Update" asp-route-id="@p.Id"
                               class="btn btn-sm"
                               style="background:var(--cream-warm);border:1px solid var(--soft-gray);color:var(--coffee-dark);">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <button class="btn btn-sm btn-danger" onclick="deleteProduct(@p.Id, '@p.Name.Replace("'","\\'")')">
                                <i class="bi bi-trash"></i>
                            </button>
                        </div>

                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-cup-hot display-4 d-block mb-3 opacity-50"></i>
            <p class="fw-semibold">No se encontraron productos@(!string.IsNullOrEmpty(Model.SearchTerm) ? " para \"" + Model.SearchTerm + "\"" : "").</p>
            <a asp-page="./Create" class="btn-form-save btn mt-2">
                <i class="bi bi-plus-circle me-1"></i>Crear primer producto
            </a>
        </div>
    }
</div>

@section Scripts {
<script>
function deleteProduct(id, name) {
    if (!confirm(`¿Eliminar el producto "${name}"? Esta acción también eliminará sus presentaciones.`)) return;

    fetch(`/Product/List?handler=Delete&id=${id}`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' }
    })
    .then(r => r.json())
    .then(res => {
        if (res.success === true) location.reload();
        else alert('Error al eliminar: ' + (res.message ?? 'Error desconocido'));
    })
    .catch(e => alert('Error de conexión: ' + e.message));
}
</script>
}
