@page
@model Coffee.WebSite.Pages.Product.CreateModel
@{
    ViewData["Title"] = "Agregar Producto";
}

@section Styles {
    <style>
        body {
            background-color: #f8f1e9 !important; /* Color crema principal */
        }

        .main-content {
            background-color: #fdfbf7;
            min-height: 100vh;
            padding-bottom: 4rem;
        }

        .page-header {
            background: linear-gradient(135deg, #2c1d11, #6f4e37);
            color: white;
            padding: 2rem 0;
            border-radius: 0 0 20px 20px;
            margin-bottom: 2.5rem;
        }

        .card-custom {
            border: none;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(44, 29, 17, 0.06);
            padding: 2.5rem;
        }

        .form-label {
            color: #2c1d11;
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .input-group-text {
            background-color: #fdfbf7;
            border-color: #e9e4dc;
            color: #6f4e37;
        }

        .form-control {
            border-color: #e9e4dc;
            padding: 0.65rem 0.75rem;
            background-color: #fdfbf7;
            font-size: 0.95rem;
            border-radius: 8px;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: #6f4e37;
            box-shadow: 0 0 0 0.25rem rgba(111, 78, 55, 0.15);
        }

        .form-check-input:checked {
            background-color: #6f4e37;
            border-color: #6f4e37;
        }

        /* Botones integrados a la identidad */
        .btn-coffee-save {
            background-color: #6f4e37;
            border-color: #6f4e37;
            color: white;
            font-weight: 600;
            padding: 0.65rem 1.5rem;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-coffee-save:hover {
            background-color: #2c1d11;
            border-color: #2c1d11;
            color: white;
        }

        .btn-coffee-cancel {
            background-color: transparent;
            border: 1px solid #c8b195;
            color: #6f4e37;
            font-weight: 600;
            padding: 0.65rem 1.5rem;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-coffee-cancel:hover {
            background-color: #f5e8d3;
            color: #2c1d11;
            border-color: #6f4e37;
        }

        .alert-custom {
            background-color: #fdf2f2;
            border: 1px solid #fbd5d5;
            color: #9b1c1c;
            border-radius: 8px;
            font-size: 0.9rem;
        }
    </style>
}

<div class="main-content">
    <div class="page-header text-center">
        <div class="container">
            <h1 class="display-5 fw-bold">Nuevo Producto</h1>
            <p class="lead mb-0">Agrega un nuevo elemento al menú de venta de la cafetería</p>
        </div>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-7 col-md-9">
                
                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-custom d-flex align-items-center mb-4 p-3" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                        <div>@Model.ErrorMessage</div>
                    </div>
                }

                <div class="card card-custom">
                    <form method="post" autocomplete="off">
                        
                        <div class="row g-3">
                            <div class="col-12">
                                <label asp-for="ProductDto.Name" class="form-label">Nombre del Producto</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-cup-hot-fill"></i></span>
                                    <input asp-for="ProductDto.Name" class="form-control" placeholder="ej: Capuccino Helado" required autofocus />
                                </div>
                                <span asp-validation-for="ProductDto.Name" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="ProductDto.CategoryId" class="form-label">Categoría ID (Relación del Catálogo)</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-folder2-open"></i></span>
                                    <input asp-for="ProductDto.CategoryId" class="form-control" type="number" placeholder="ej: 1" required />
                                </div>
                                <span asp-validation-for="ProductDto.CategoryId" class="text-danger small"></span>
                            </div>

                            <div class="col-12">
                                <label asp-for="ProductDto.Description" class="form-label">Descripción o Ingredientes</label>
                                <textarea asp-for="ProductDto.Description" class="form-control" rows="3" placeholder="Detalla los componentes del producto o notas para el ticket..."></textarea>
                                <span asp-validation-for="ProductDto.Description" class="text-danger small"></span>
                            </div>

                            <div class="col-12 mt-3">
                                <div class="form-check form-switch p-0 ps-5">
                                    <input asp-for="ProductDto.IsActive" class="form-check-input fs-5 ms-5" type="checkbox" role="switch" checked />
                                    <label asp-for="ProductDto.IsActive" class="form-check-label fw-bold pt-1 text-dark" style="margin-left: 10px;">Disponible para la venta inmediata</label>
                                </div>
                            </div>
                        </div>

                        <hr class="text-muted my-4" />

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-page="./List" class="btn btn-coffee-cancel">
                                <i class="bi bi-x-circle me-1"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-coffee-save">
                                <i class="bi bi-plus-circle me-1"></i> Crear Producto
                            </button>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}