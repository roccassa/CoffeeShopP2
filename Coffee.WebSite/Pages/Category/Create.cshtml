@page
@model Coffee.WebSite.Pages.Category.CreateModel
@{
    ViewData["Title"] = "Nueva Categoría";
}

@section Styles {
    <style>
        body {
            background-color: #f8f1e9 !important;
        }

        .main-content {
            background-color: #fdfbf7;
            min-height: 100vh;
            padding-bottom: 4rem;
        }

        .page-header {
            background: linear-gradient(135deg, #2c1d11, #6f4e37);
            color: white;
            padding: 2rem 0;
            border-radius: 0 0 20px 20px;
            margin-bottom: 2.5rem;
        }

        .card-custom {
            border: none;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(44, 29, 17, 0.06);
            padding: 2.5rem;
        }

        .form-label {
            color: #2c1d11;
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .input-group-text {
            background-color: #fdfbf7;
            border-color: #e9e4dc;
            color: #6f4e37;
        }

        .form-control {
            border-color: #e9e4dc;
            padding: 0.65rem 0.75rem;
            background-color: #fdfbf7;
            font-size: 0.95rem;
            border-radius: 8px;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: #6f4e37;
            box-shadow: 0 0 0 0.25rem rgba(111, 78, 55, 0.15);
        }

        /* Botones unificados */
        .btn-coffee-save {
            background-color: #6f4e37;
            border-color: #6f4e37;
            color: white;
            font-weight: 600;
            padding: 0.65rem 1.5rem;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-coffee-save:hover {
            background-color: #2c1d11;
            border-color: #2c1d11;
            color: white;
        }

        .btn-coffee-cancel {
            background-color: transparent;
            border: 1px solid #c8b195;
            color: #6f4e37;
            font-weight: 600;
            padding: 0.65rem 1.5rem;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-coffee-cancel:hover {
            background-color: #f5e8d3;
            color: #2c1d11;
            border-color: #6f4e37;
        }
    </style>
}

<div class="main-content">
    <div class="page-header text-center">
        <div class="container">
            <h1 class="display-5 fw-bold">Crear Nueva Categoría</h1>
            <p class="lead mb-0">Añade clasificaciones estructurales para segmentar los productos en la interfaz táctil</p>
        </div>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">

                <div class="card card-custom">
                    <form method="post" autocomplete="off">
                        
                        <div class="mb-3">
                            <label class="form-label">Nombre de la Categoría</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-folder-fill"></i></span>
                                <input type="text" name="CategoryDto.Name" class="form-control" placeholder="ej: Bebidas Frías, Snacks, Pastelería" required autofocus />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Descripción o Notas de Clasificación</label>
                            <textarea name="CategoryDto.Description" class="form-control" rows="3" placeholder="Ingresa notas breves sobre el grupo de productos..."></textarea>
                        </div>

                        <hr class="text-muted my-4" />

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-page="./List" class="btn btn-coffee-cancel">
                                <i class="bi bi-x-circle me-1"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-coffee-save">
                                <i class="bi bi-plus-circle me-1"></i> Guardar Categoría
                            </button>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>
</div>