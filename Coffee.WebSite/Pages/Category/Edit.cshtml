@page "{id:int?}"
@model Coffee.WebSite.Pages.Category.EditModel

@{
    var isNew = Model.Category.Id == 0;
    ViewData["Title"] = isNew ? "Add Category" : "Edit Category";
}

<div class="container">
    <h2>@ViewData["Title"]</h2>
    <hr />

    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <input type="hidden" asp-for="Category.Id" />

                <div class="mb-3">
                    <label asp-for="Category.Name" class="form-label">Name</label>
                    <input asp-for="Category.Name" class="form-control" required />
                </div>

                <div class="mb-3">
                    <label asp-for="Category.Description" class="form-label">Description</label>
                    <textarea asp-for="Category.Description" class="form-control" rows="3"></textarea>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        @(isNew ? "Create" : "Save Changes")
                    </button>
                    <a asp-page="./List" class="btn btn-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>