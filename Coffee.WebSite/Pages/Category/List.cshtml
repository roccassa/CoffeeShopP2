@page
@model Coffee.WebSite.Pages.Category.ListModel

<div class="container-fluid mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Listado de Categorías de Café</h2>
    </div>

    <form method="get" class="mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-md-6">
                <input type="text" 
                       name="searchTerm" 
                       value="@Model.SearchTerm"
                       class="form-control" 
                       placeholder="Buscar categoría por nombre o ID..." />
            </div>
            
            <div class="col-md-4">
                <button id="btnSearch" class="btn btn-primary me-2">Buscar</button>
                <a asp-page="./Create" class="btn btn-success">Agregar Nueva</a>
            </div>
        </div>
    </form>
    
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm">
                <div class="card-body p-0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">ID</th>
                                <th>Nombre de Categoría</th>
                                <th>Descripción</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                        @if (Model.Categories != null && Model.Categories.Any())
                        {
                            @foreach (var category in Model.Categories)
                            {
                                <tr>
                                    <td class="ps-4">@category.Id</td>
                                    <td class="fw-bold">@category.Name</td>
                                    <td>@category.Description</td>
                                    <td class="text-end pe-4">
                                        <a asp-page="./Update" asp-route-id="@category.Id" class="btn btn-warning btn-sm me-1">Editar</a>
                                        <button class="btn btn-danger btn-sm" onclick="deleteCategory(@category.Id)">
                                            Eliminar
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">
                                    No se encontraron categorías registradas.
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteCategory(id) {
            if (!confirm("¿Estás seguro de que deseas eliminar esta categoría de café?")) {
                return;
            }

            // Construcción limpia de la URL apuntando al Handler OnPostDeleteAsync
            const url = `/Category/List?handler=Delete&id=${id}`;

            fetch(url, {
                method: 'POST' 
            })
            .then(response => {
                if (!response.ok) {
                    throw new Error(`Error en el servidor: ${response.status}`);
                }
                return response.json();
            })
            .then(result => {
                // Evaluamos si el backend reportó éxito en la operación
                if (result.success === true || result.data === true) {
                    alert("Categoría eliminada correctamente");
                    location.reload(); // Recarga la página para refrescar la grilla de datos
                } else {
                    alert("Error al eliminar: " + (result.errors?.join(", ") || "Inconsistencia en el servidor"));
                }
            })
            .catch(error => {
                console.error("Detalle del error crítico:", error);
                alert("Ocurrió un error crítico al procesar la solicitud: " + error.message);
            });
        }


        function deleteCategory(id) {
            if (!confirm("¿Estás seguro de que deseas eliminar esta categoría?")) return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const url = `/Category/List?handler=Delete&id=${id}`;

            fetch(url, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token ?? ''
                }
            })
                .then(response => {
                    if (!response.ok) throw new Error(`Error: ${response.status}`);
                    return response.json();
                })
                .then(result => {
                    if (result === true || result.success === true) {
                        alert("Categoría eliminada correctamente");
                        location.reload();
                    } else {
                        alert("Error al eliminar");
                    }
                })
                .catch(error => alert("Error: " + error.message));
        }
    </script>
}