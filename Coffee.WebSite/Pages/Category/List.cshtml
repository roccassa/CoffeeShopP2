@page
@model Coffee.WebSite.Pages.Category.ListModel

@{
    ViewData["Title"] = "Categorías de Café";
}

@section Styles {
<style>
    .main-content { background-color: var(--cream); min-height: 100vh; padding-bottom: 3rem; }

    .category-badge {
        font-size: 0.88rem; padding: 0.3rem 0.75rem; border-radius: 6px;
        background-color: var(--cream-warm); color: var(--coffee-dark);
        display: inline-block; border: 1px solid #c8b195; font-weight: 600;
    }
    .btn-success { background-color: var(--coffee-medium); border-color: var(--coffee-medium); font-weight: 600; }
    .btn-success:hover { background-color: var(--coffee-dark); border-color: var(--coffee-dark); }
</style>
}

<div class="main-content">
    <div class="page-header">
        <div class="container d-flex align-items-center justify-content-between flex-wrap gap-2">
            <div>
                <h1 class="fw-bold mb-0 fs-4"><i class="bi bi-tags-fill me-2"></i>Categorías del Menú</h1>
                <p class="mb-0 opacity-75 small">Organiza las secciones que aparecen en la pantalla de toma de órdenes</p>
            </div>
            <a asp-page="./Create" class="btn btn-light fw-bold" style="border-radius:8px; color:var(--coffee-dark);">
                <i class="bi bi-folder-plus me-1"></i>Nueva Categoría
            </a>
        </div>
    </div>

    <div class="container">
        <form method="get" class="mb-4">
            @Html.AntiForgeryToken()
            <div class="input-group" style="max-width:420px;">
                <span class="input-group-text" style="background:var(--cream-warm);border-color:var(--soft-gray);">
                    <i class="bi bi-search text-muted"></i>
                </span>
                <input type="text" name="searchTerm" value="@Model.SearchTerm"
                       class="form-control" placeholder="Buscar por nombre o ID…"
                       style="border-color:var(--soft-gray);" />
                <button class="btn" style="background:var(--coffee-dark);color:#fff;border:none;">Buscar</button>
            </div>
        </form>
        
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-body p-0">
                        <table class="table table-hover mb-0">
                            <thead>
                                <tr>
                                    <th class="ps-4" style="width: 15%;">ID</th>
                                    <th style="width: 30%;">Nombre de Categoría</th>
                                    <th style="width: 40%;">Descripción</th>
                                    <th class="text-end pe-4" style="width: 15%;">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                            @if (Model.Categories != null && Model.Categories.Any())
                            {
                                @foreach (var category in Model.Categories)
                                {
                                    <tr>
                                        <td class="ps-4 fw-bold text-muted">@category.Id</td>
                                        <td>
                                            <span class="category-badge fw-bold">
                                                <i class="bi bi-tag-fill text-brown me-1" style="color: #6f4e37;"></i> @category.Name
                                            </span>
                                        </td>
                                        <td class="text-secondary small">@category.Description</td>
                                        <td class="text-end pe-4">
                                            <a asp-page="./Update" asp-route-id="@category.Id" class="btn btn-warning btn-sm me-2">
                                                <i class="bi bi-pencil"></i> Editar
                                            </a>
                                            <button class="btn btn-danger btn-sm" onclick="deleteCategory(@category.Id)">
                                                <i class="bi bi-trash"></i> Eliminar
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted py-5">
                                        <i class="bi bi-folder-x display-6 d-block mb-2 text-muted"></i>
                                        No se encontraron categorías comerciales registradas.
                                    </td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteCategory(id) {
            if (!confirm("¿Estás completamente seguro de que deseas eliminar esta categoría? Esto podría desvincular los productos asociados a ella.")) 
                return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const url = `/Category/List?handler=Delete&id=${id}`;

            fetch(url, {
                method: 'POST',
                headers: {
                    'RequestVerificationToken': token ?? ''
                }
            })
            .then(response => {
                if (!response.ok) throw new Error(`Error en la petición: ${response.status}`);
                return response.json();
            })
            .then(result => {
                if (result === true || result.success === true) {
                    alert("✅ Categoría removida con éxito");
                    location.reload();
                } else {
                    alert("❌ Error al eliminar la categoría del catálogo");
                }
            })
            .catch(error => alert("Error crítico en la comunicación: " + error.message));
        }
    </script>
}