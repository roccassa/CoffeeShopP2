@page
@model Coffee.WebSite.Pages.Account.LoginModel

@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Iniciar Sesión - Coffee Management</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    
    <style>
        body {
            background-color: #fdfbf7; /* Color crema */
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            margin: 0;
            overflow: hidden;
        }

        /* Contenedor tipo Tarjeta Minimalista */
        .login-card {
            background: #ffffff;
            border: 1px solid #e9e4dc; /* soft-gray directo */
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(44, 29, 17, 0.05);
            width: 100%;
            max-width: 420px;
            padding: 2.5rem 2rem;
            transition: transform 0.3s ease;
        }

        /* Identidad de la marca de la cafetería */
        .brand-section {
            text-align: center;
            margin-bottom: 2rem;
        }

        .brand-icon {
            font-size: 3rem;
            color: #6f4e37; /* accent-coffee-light directo */
            margin-bottom: 0.5rem;
            display: inline-block;
        }

        .brand-title {
            color: #2c1d11; /* dark-coffee directo */
            font-weight: 700;
            font-size: 1.5rem;
            letter-spacing: -0.5px;
            margin-bottom: 0.25rem;
        }

        .brand-subtitle {
            color: #8c857b;
            font-size: 0.875rem;
        }

        /* Estilos de los inputs del panel de administración */
        .form-label {
            color: #2c1d11; /* dark-coffee directo */
            font-weight: 600;
            font-size: 0.85rem;
            margin-bottom: 0.5rem;
        }

        .input-group-text {
            background-color: #fdfbf7; /* cream-bg directo */
            border-color: #e9e4dc;
            color: #6f4e37;
        }

        .form-control {
            border-color: #e9e4dc;
            padding: 0.6rem 0.75rem;
            background-color: #fdfbf7;
            font-size: 0.95rem;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: #6f4e37;
            box-shadow: 0 0 0 0.25rem rgba(111, 78, 55, 0.15);
        }

        /* Botón de acción principal */
        .btn-coffee {
            background-color: #2c1d11; /* dark-coffee directo */
            color: #ffffff;
            font-weight: 600;
            padding: 0.7rem;
            border-radius: 8px;
            border: none;
            transition: background-color 0.2s ease;
            width: 100%;
            margin-top: 1rem;
        }

        .btn-coffee:hover {
            background-color: #6f4e37;
            color: #ffffff;
        }

        /* Alertas de error estilizadas */
        .alert-custom {
            background-color: #fdf2f2;
            border: 1px solid #fbd5d5;
            color: #9b1c1c;
            font-size: 0.85rem;
            border-radius: 8px;
            padding: 0.75rem;
            margin-bottom: 1.5rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="brand-section">
            <div class="brand-icon">
                <i class="bi bi-cup-hot-fill"></i>
            </div>
            <h1 class="brand-title">Cafetería Control</h1>
            <p class="brand-subtitle">Panel Administrativo de Gestión</p>
        </div>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Values.Any(v => v.Errors.Any()))
        {
            <div class="alert-custom">
                <i class="bi bi-exclamation-circle-fill"></i>
                <div>
                    @foreach (var modelState in ViewData.ModelState.Values)
                    {
                        @foreach (var error in modelState.Errors)
                        {
                            <span>@error.ErrorMessage</span>
                        }
                    }
                </div>
            </div>
        }

        <form method="post" autocomplete="off">
            <div class="mb-3">
                <label for="username" class="form-label">Usuario de Sistema</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-person-fill"></i></span>
                    <input type="text" 
                           id="username" 
                           name="Username" 
                           class="form-control" 
                           placeholder="ej: admin_barista" 
                           required 
                           autofocus />
                </div>
            </div>

            <div class="mb-4">
                <label for="password" class="form-label">Contraseña</label>
                <div class="input-group">
                    <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                    <input type="password" 
                           id="password" 
                           name="Password" 
                           class="form-control" 
                           placeholder="••••••••" 
                           required />
                </div>
            </div>

            <button type="submit" class="btn-coffee">
                Ingresar al Panel <i class="bi bi-arrow-right-short"></i>
            </button>
        </form>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>