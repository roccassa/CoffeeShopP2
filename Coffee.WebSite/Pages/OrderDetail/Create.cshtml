@page
@model Coffee.WebSite.Pages.OrderDetail.CreateModel

@{ ViewData["Title"] = "Agregar Detalle de Orden"; }

<div class="container mt-4">
    <h2>Agregar Detalle de Orden</h2>
    <hr />
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <div class="mb-3">
                    <label asp-for="OrderDetailDto.OrderId" class="form-label">Orden ID</label>
                    <input asp-for="OrderDetailDto.OrderId" class="form-control" type="number" required />
                </div>
                <div class="mb-3">
                    <label asp-for="OrderDetailDto.ProductVariantId" class="form-label">Presentación ID</label>
                    <input asp-for="OrderDetailDto.ProductVariantId" class="form-control" type="number" required />
                </div>
                <div class="mb-3">
                    <label asp-for="OrderDetailDto.Quantity" class="form-label">Cantidad</label>
                    <input asp-for="OrderDetailDto.Quantity" class="form-control" type="number" required />
                </div>
                <div class="mb-3">
                    <label asp-for="OrderDetailDto.UnitPrice" class="form-label">Precio Unitario</label>
                    <input asp-for="OrderDetailDto.UnitPrice" class="form-control" type="number" step="0.01" required />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-success">Crear</button>
                    <a asp-page="./List" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
