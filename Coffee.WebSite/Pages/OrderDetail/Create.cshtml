@page
@model Coffee.WebSite.Pages.OrderDetail.CreateModel
@{
    ViewData["Title"] = "Agregar Concepto a Orden";
    var variantsJson = System.Text.Json.JsonSerializer.Serialize(
        Model.Variants.Select(v => new { id = v.Id, price = v.Price }));
}

<div class="page-header">
    <div class="container">
        <h1 class="fw-bold mb-0 fs-4"><i class="bi bi-plus-circle me-2"></i>Agregar Concepto a Orden</h1>
        <p class="mb-0 opacity-75 small">Vincula manualmente un producto a un ticket de venta activo</p>
    </div>
</div>

<div class="container" style="padding-bottom:3rem;">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert-form-error d-flex align-items-center gap-2 p-3 mb-3">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <div class="form-card">
                <form method="post" autocomplete="off">

                    <!-- Orden (dropdown) -->
                    <div class="mb-3">
                        <label class="form-label">Orden (Ticket)</label>
                        <select asp-for="OrderDetailDto.OrderId" class="form-select" required>
                            <option value="">— Selecciona una orden —</option>
                            @foreach (var o in Model.Orders)
                            {
                                <option value="@o.Id">
                                    #@o.Id — @o.UserName · @o.Status · $@o.Total.ToString("F2")
                                </option>
                            }
                        </select>
                        <span asp-validation-for="OrderDetailDto.OrderId" class="text-danger small"></span>
                    </div>

                    <!-- Presentación (dropdown) con auto-fill de precio -->
                    <div class="mb-3">
                        <label class="form-label">Producto / Presentación</label>
                        <select asp-for="OrderDetailDto.ProductVariantId" class="form-select" required
                                onchange="fillPrice(this.value)">
                            <option value="">— Selecciona un producto —</option>
                            @foreach (var v in Model.Variants)
                            {
                                <option value="@v.Id">
                                    @v.ProductName — @v.Size ($@v.Price.ToString("F2"))
                                </option>
                            }
                        </select>
                        <span asp-validation-for="OrderDetailDto.ProductVariantId" class="text-danger small"></span>
                    </div>

                    <!-- Cantidad -->
                    <div class="mb-3">
                        <label class="form-label">Cantidad</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-calculator"></i></span>
                            <input asp-for="OrderDetailDto.Quantity" class="form-control"
                                   type="number" min="1" placeholder="1" required
                                   oninput="updateSubtotal()" />
                        </div>
                        <span asp-validation-for="OrderDetailDto.Quantity" class="text-danger small"></span>
                    </div>

                    <!-- Precio unitario (auto-filled) -->
                    <div class="mb-3">
                        <label class="form-label">Precio Unitario</label>
                        <div class="input-group">
                            <span class="input-group-text fw-bold">$</span>
                            <input asp-for="OrderDetailDto.UnitPrice" class="form-control"
                                   type="number" step="0.01" min="0" placeholder="0.00" required
                                   id="unitPrice" oninput="updateSubtotal()" />
                        </div>
                        <span asp-validation-for="OrderDetailDto.UnitPrice" class="text-danger small"></span>
                    </div>

                    <!-- Subtotal preview -->
                    <div class="mb-4 p-3 rounded d-flex justify-content-between fw-bold"
                         style="background:var(--cream-warm); font-family:'Courier New',monospace;">
                        <span>Subtotal estimado:</span>
                        <span id="subtotalPreview">$0.00</span>
                    </div>

                    <hr class="my-3" />
                    <div class="d-flex justify-content-end gap-3">
                        <a asp-page="./List" class="btn-form-cancel btn">
                            <i class="bi bi-x-circle me-1"></i>Cancelar
                        </a>
                        <button type="submit" class="btn-form-save btn">
                            <i class="bi bi-check-circle me-1"></i>Insertar Concepto
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
const VARIANT_PRICES = @Html.Raw(variantsJson);

function fillPrice(variantId) {
    const v = VARIANT_PRICES.find(x => x.id == variantId);
    if (v) {
        document.getElementById('unitPrice').value = v.price.toFixed(2);
        updateSubtotal();
    }
}

function updateSubtotal() {
    const price = parseFloat(document.getElementById('unitPrice').value) || 0;
    const qty   = parseFloat(document.querySelector('[name="OrderDetailDto.Quantity"]').value) || 0;
    document.getElementById('subtotalPreview').textContent = '$' + (price * qty).toFixed(2);
}
</script>
}
