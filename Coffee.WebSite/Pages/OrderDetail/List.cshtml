@page
@model Coffee.WebSite.Pages.OrderDetail.ListModel

@{
    ViewData["Title"] = "Detalles de Órdenes";
}

@section Styles {
    <style>
        body {
            background-color: #f8f1e9 !important; /* Crema principal */
        }

        .main-content {
            background-color: #fdfbf7;
            min-height: 100vh;
            padding-bottom: 3rem;
        }

        .page-header {
            background: linear-gradient(135deg, #2c1d11, #6f4e37);
            color: white;
            padding: 2rem 0;
            border-radius: 0 0 20px 20px;
            margin-bottom: 2rem;
        }

        .card {
            border: none;
            box-shadow: 0 10px 30px rgba(44, 29, 17, 0.08);
            border-radius: 12px;
            overflow: hidden;
        }

        .table thead {
            background-color: #2c1d11;
            color: #f5e8d3;
        }

        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            padding: 1rem 0.75rem;
        }

        .table td {
            padding: 1rem 0.75rem;
            vertical-align: middle;
        }

        .btn-success {
            background-color: #6f4e37;
            border-color: #6f4e37;
            font-weight: 500;
        }

        .btn-success:hover {
            background-color: #2c1d11;
            border-color: #2c1d11;
        }

        .form-control {
            border-color: #e9e4dc;
            background-color: #fdfbf7;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: #6f4e37;
            box-shadow: 0 0 0 0.25rem rgba(111, 78, 55, 0.15);
        }

        .ticket-badge {
            background-color: #f5e8d3;
            color: #2c1d11;
            border: 1px solid #c8b195;
            padding: 0.35rem 0.7rem;
            border-radius: 6px;
            font-weight: 600;
            display: inline-block;
        }

        .price-text {
            font-family: 'Courier New', Courier, monospace;
            font-weight: 600;
            color: #475569;
        }

        .subtotal-text {
            font-family: 'Courier New', Courier, monospace;
            font-weight: 700;
            color: #1e293b;
            font-size: 1.05rem;
        }
    </style>
}

<div class="main-content">
    <div class="page-header text-center">
        <div class="container">
            <h1 class="display-5 fw-bold">Desglose de Conceptos</h1>
            <p class="lead mb-0">Audita las líneas de productos, cantidades y precios unitarios asociados a cada ticket</p>
        </div>
    </div>

    <div class="container">
        <form method="get" class="mb-4">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text" name="searchTerm" value="@Model.SearchTerm"
                               class="form-control" placeholder="Buscar por ID de desglose u Orden ID..." />
                        <button class="btn btn-primary" style="background-color:#2c1d11; border:none;">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                    </div>
                </div>
                <div class="col-md-4">
                    <a asp-page="./Create" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Agregar Concepto Manual
                    </a>
                </div>
            </div>
        </form>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 12%;">ID Línea</th>
                            <th style="width: 18%;">Orden (Ticket)</th>
                            <th style="width: 18%;">Presentación ID</th>
                            <th style="width: 14%;">Cantidad</th>
                            <th style="width: 18%;">Precio Unitario</th>
                            <th style="width: 15%;">Subtotal</th>
                            <th class="text-end pe-4" style="width: 15%;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                    {
                        @foreach (var detail in Model.OrderDetails)
                        {
                            decimal subtotal = detail.Quantity * detail.UnitPrice;
                            <tr>
                                <td class="ps-4 fw-bold text-muted">#@detail.Id</td>
                                <td>
                                    <span class="ticket-badge">
                                        <i class="bi bi-receipt me-1"></i> Orden #@detail.OrderId
                                    </span>
                                </td>
                                <td class="text-secondary small">
                                    <i class="bi bi-box-seam me-1"></i> ID: @detail.ProductVariantId
                                </td>
                                <td class="fw-bold text-dark">
                                    @detail.Quantity <span class="text-muted font-weight-normal small">pzas</span>
                                </td>
                                <td>
                                    <span class="price-text">$@detail.UnitPrice.ToString("F2")</span>
                                </td>
                                <td>
                                    <span class="subtotal-text">$@subtotal.ToString("F2")</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-page="./Update" asp-route-id="@detail.Id" class="btn btn-warning btn-sm me-2">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <button class="btn btn-danger btn-sm" onclick="deleteDetail(@detail.Id)">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="7" class="text-center text-muted py-5">
                                <i class="bi bi-list-task display-6 d-block mb-2 text-muted"></i>
                                No se encontraron conceptos o líneas desglosadas en esta consulta.
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteDetail(id) {
            if (!confirm("¿Estás completamente seguro de que deseas eliminar esta línea de detalle? Esto modificará de forma colateral el cálculo del total general de la orden.")) 
                return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            
            fetch(`/OrderDetail/List?handler=Delete&id=${id}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token ?? '' }
            })
            .then(r => { if (!r.ok) throw new Error(r.status); return r.json(); })
            .then(result => {
                if (result === true || result.success === true || result === "true") {
                    alert("✅ Concepto removido correctamente");
                    location.reload();
                } else {
                    alert("❌ Error al intentar remover el concepto");
                }
            })
            .catch(e => alert("Error crítico de comunicación: " + e.message));
        }
    </script>
}