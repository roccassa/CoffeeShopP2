@page
@model Coffee.WebSite.Pages.OrderDetail.ListModel

<div class="container-fluid mt-4">
    <h2 class="mb-4">Detalles de Órdenes</h2>
    <form method="get" class="mb-4">
        @Html.AntiForgeryToken()
        <div class="row g-3 align-items-center">
            <div class="col-md-6">
                <input type="text" name="searchTerm" value="@Model.SearchTerm"
                       class="form-control" placeholder="Buscar por ID u Orden ID..." />
            </div>
            <div class="col-md-4">
                <button class="btn btn-primary me-2">Buscar</button>
                <a asp-page="./Create" class="btn btn-success">Agregar Nuevo</a>
            </div>
        </div>
    </form>
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4">ID</th>
                        <th>Orden ID</th>
                        <th>Presentación ID</th>
                        <th>Cantidad</th>
                        <th>Precio Unitario</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                @if (Model.OrderDetails != null && Model.OrderDetails.Any())
                {
                    @foreach (var detail in Model.OrderDetails)
                    {
                        <tr>
                            <td class="ps-4">@detail.Id</td>
                            <td>@detail.OrderId</td>
                            <td>@detail.ProductVariantId</td>
                            <td>@detail.Quantity</td>
                            <td>$@detail.UnitPrice</td>
                            <td class="text-end pe-4">
                                <a asp-page="./Update" asp-route-id="@detail.Id" class="btn btn-warning btn-sm me-1">Editar</a>
                                <button class="btn btn-danger btn-sm" onclick="deleteDetail(@detail.Id)">Eliminar</button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">No se encontraron detalles.</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteDetail(id) {
            if (!confirm("¿Deseas eliminar este detalle?")) return;
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
            fetch(`/OrderDetail/List?handler=Delete&id=${id}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token ?? '' }
            })
            .then(r => { if (!r.ok) throw new Error(r.status); return r.json(); })
            .then(result => {
                if (result === true) { alert("Detalle eliminado correctamente"); location.reload(); }
                else { alert("Error al eliminar el detalle"); }
            })
            .catch(e => alert("Error: " + e.message));
        }
    </script>
}
