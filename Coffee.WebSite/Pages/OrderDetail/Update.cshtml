@page "{id:int}"
@model Coffee.WebSite.Pages.OrderDetail.UpdateModel
@{
    ViewData["Title"] = "Editar Detalle de Orden";
}

@section Styles {
    <style>
        body {
            background-color: #f8f1e9 !important;
        }

        .main-content {
            background-color: #fdfbf7;
            min-height: 100vh;
            padding-bottom: 4rem;
        }

        .page-header {
            background: linear-gradient(135deg, #2c1d11, #6f4e37);
            color: white;
            padding: 2rem 0;
            border-radius: 0 0 20px 20px;
            margin-bottom: 2.5rem;
        }

        .card-custom {
            border: none;
            background: #ffffff;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(44, 29, 17, 0.06);
            padding: 2.5rem;
        }

        .form-label {
            color: #2c1d11;
            font-weight: 600;
            font-size: 0.9rem;
            margin-bottom: 0.5rem;
        }

        .input-group-text {
            background-color: #fdfbf7;
            border-color: #e9e4dc;
            color: #6f4e37;
        }

        .form-control {
            border-color: #e9e4dc;
            padding: 0.65rem 0.75rem;
            background-color: #fdfbf7;
            font-size: 0.95rem;
            border-radius: 8px;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: #6f4e37;
            box-shadow: 0 0 0 0.25rem rgba(111, 78, 55, 0.15);
        }

        .btn-coffee-update {
            background-color: #2c1d11;
            border-color: #2c1d11;
            color: white;
            font-weight: 600;
            padding: 0.65rem 1.5rem;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-coffee-update:hover {
            background-color: #6f4e37;
            border-color: #6f4e37;
            color: white;
        }

        .btn-coffee-cancel {
            background-color: transparent;
            border: 1px solid #c8b195;
            color: #6f4e37;
            font-weight: 600;
            padding: 0.65rem 1.5rem;
            border-radius: 8px;
            transition: all 0.2s ease;
        }

        .btn-coffee-cancel:hover {
            background-color: #f5e8d3;
            color: #2c1d11;
            border-color: #6f4e37;
        }

        .alert-custom {
            background-color: #fdf2f2;
            border: 1px solid #fbd5d5;
            color: #9b1c1c;
            border-radius: 8px;
            font-size: 0.9rem;
        }
    </style>
}

<div class="main-content">
    <div class="page-header text-center">
        <div class="container">
            <h1 class="display-5 fw-bold">Modificar Concepto de Orden</h1>
            <p class="lead mb-0">Ajusta las cantidades vendidas o rectifica precios unitarios de la línea</p>
        </div>
    </div>

    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-6 col-md-8">

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="alert alert-custom d-flex align-items-center mb-4 p-3" role="alert">
                        <i class="bi bi-exclamation-circle-fill me-2 fs-5"></i>
                        <div>@Model.ErrorMessage</div>
                    </div>
                }

                <div class="card card-custom">
                    <form method="post" autocomplete="off">
                        <input type="hidden" asp-for="OrderDetailDto.Id" />
                        
                        <div class="mb-3">
                            <label asp-for="OrderDetailDto.OrderId" class="form-label">ID de la Orden Principal</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-receipt"></i></span>
                                <input asp-for="OrderDetailDto.OrderId" class="form-control" type="number" required autofocus />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OrderDetailDto.ProductVariantId" class="form-label">ID de la Presentación de Producto</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-box-seam-fill"></i></span>
                                <input asp-for="OrderDetailDto.ProductVariantId" class="form-control" type="number" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="OrderDetailDto.Quantity" class="form-label">Cantidad Comprada</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-calculator"></i></span>
                                <input asp-for="OrderDetailDto.Quantity" class="form-control" type="number" required min="1" />
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="OrderDetailDto.UnitPrice" class="form-label">Precio Unitario ($)</label>
                            <div class="input-group">
                                <span class="input-group-text fw-bold">$</span>
                                <input asp-for="OrderDetailDto.UnitPrice" class="form-control" type="number" step="0.01" required min="0" />
                            </div>
                        </div>

                        <hr class="text-muted my-4" />

                        <div class="d-flex justify-content-end gap-3">
                            <a asp-page="./List" class="btn btn-coffee-cancel">
                                <i class="bi bi-x-circle me-1"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-coffee-update">
                                <i class="bi bi-pencil-square me-1"></i> Guardar Cambios
                            </button>
                        </div>

                    </form>
                </div>

            </div>
        </div>
    </div>
</div>