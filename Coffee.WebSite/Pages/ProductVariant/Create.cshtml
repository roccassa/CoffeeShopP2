@page
@model Coffee.WebSite.Pages.ProductVariant.CreateModel
@{
    ViewData["Title"] = "Nueva Presentación";
}

<div class="page-header">
    <div class="container">
        <h1 class="fw-bold mb-0 fs-4"><i class="bi bi-plus-circle me-2"></i>Nueva Presentación</h1>
        <p class="mb-0 opacity-75 small">Asigna tamaño y precio a un producto del menú</p>
    </div>
</div>

<div class="container" style="padding-bottom:3rem;">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert-form-error d-flex align-items-center gap-2 p-3 mb-3">
                    <i class="bi bi-exclamation-triangle-fill fs-5"></i>
                    <span>@Model.ErrorMessage</span>
                </div>
            }

            <div class="form-card">
                <form method="post" autocomplete="off">

                    <!-- Producto (dropdown) -->
                    <div class="mb-3">
                        <label class="form-label">Producto</label>
                        <select asp-for="ProductVariantDto.ProductId" class="form-select" required>
                            <option value="">— Selecciona un producto —</option>
                            @foreach (var p in Model.Products)
                            {
                                <option value="@p.Id">@p.Name (@p.CategoryName)</option>
                            }
                        </select>
                        <span asp-validation-for="ProductVariantDto.ProductId" class="text-danger small"></span>
                    </div>

                    <!-- Tamaño -->
                    <div class="mb-3">
                        <label class="form-label">Tamaño / Presentación</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-arrows-angle-expand"></i></span>
                            <input asp-for="ProductVariantDto.Size" class="form-control"
                                   placeholder="ej: Chico, Mediano, Grande, 500ml…" required autofocus />
                        </div>
                        <span asp-validation-for="ProductVariantDto.Size" class="text-danger small"></span>
                    </div>

                    <!-- Precio -->
                    <div class="mb-4">
                        <label class="form-label">Precio de Venta</label>
                        <div class="input-group">
                            <span class="input-group-text fw-bold">$</span>
                            <input asp-for="ProductVariantDto.Price" class="form-control"
                                   type="number" step="0.01" min="0" placeholder="0.00" required />
                        </div>
                        <span asp-validation-for="ProductVariantDto.Price" class="text-danger small"></span>
                    </div>

                    <hr class="my-3" />
                    <div class="d-flex justify-content-end gap-3">
                        <a asp-page="./List" class="btn-form-cancel btn">
                            <i class="bi bi-x-circle me-1"></i>Cancelar
                        </a>
                        <button type="submit" class="btn-form-save btn">
                            <i class="bi bi-plus-circle me-1"></i>Crear Presentación
                        </button>
                    </div>
                </form>
            </div>

        </div>
    </div>
</div>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
}
