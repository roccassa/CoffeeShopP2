@page
@model Coffee.WebSite.Pages.ProductVariant.ListModel

@{
    ViewData["Title"] = "Listado de Presentaciones";
}

@section Styles {
    <style>
        body {
            background-color: #f8f1e9 !important; /* Color crema principal */
        }

        .main-content {
            background-color: #fdfbf7;
            min-height: 100vh;
            padding-bottom: 3rem;
        }

        .page-header {
            background: linear-gradient(135deg, #2c1d11, #6f4e37);
            color: white;
            padding: 2rem 0;
            border-radius: 0 0 20px 20px;
            margin-bottom: 2rem;
        }

        .card {
            border: none;
            box-shadow: 0 10px 30px rgba(44, 29, 17, 0.08);
            border-radius: 12px;
            overflow: hidden;
        }

        .table thead {
            background-color: #2c1d11;
            color: #f5e8d3;
        }

        .table th {
            font-weight: 600;
            text-transform: uppercase;
            font-size: 0.85rem;
            letter-spacing: 0.5px;
            padding: 1rem 0.75rem;
        }

        .table td {
            padding: 1rem 0.75rem;
            vertical-align: middle;
        }

        .btn-success {
            background-color: #6f4e37;
            border-color: #6f4e37;
            font-weight: 500;
        }

        .btn-success:hover {
            background-color: #2c1d11;
            border-color: #2c1d11;
        }

        .form-control {
            border-color: #e9e4dc;
            background-color: #fdfbf7;
        }

        .form-control:focus {
            background-color: #ffffff;
            border-color: #6f4e37;
            box-shadow: 0 0 0 0.25rem rgba(111, 78, 55, 0.15);
        }

        /* Estilo para los tamaños del producto (Chico, Mediano, Grande, etc) */
        .size-badge {
            font-size: 0.85rem;
            padding: 0.35rem 0.75rem;
            border-radius: 20px;
            background-color: #f5e8d3;
            color: #2c1d11;
            border: 1px solid #c8b195;
            display: inline-block;
        }

        /* Destacar precios de la cafetería */
        .price-text {
            color: #6f4e37;
            font-size: 1.05rem;
        }
    </style>
}

<div class="main-content">
    <div class="page-header text-center">
        <div class="container">
            <h1 class="display-5 fw-bold">Presentaciones de Producto</h1>
            <p class="lead mb-0">Gestiona los tamaños, porciones y precios de venta al público</p>
        </div>
    </div>

    <div class="container">
        <form method="get" class="mb-4">
            @Html.AntiForgeryToken()
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <div class="input-group">
                        <input type="text" name="searchTerm" value="@Model.SearchTerm"
                               class="form-control" 
                               placeholder="Buscar por tamaño o ID de presentación..." />
                        <button class="btn btn-primary" style="background-color:#2c1d11; border:none;">
                            <i class="bi bi-search"></i> Buscar
                        </button>
                    </div>
                </div>
                <div class="col-md-4">
                    <a asp-page="./Create" class="btn btn-success">
                        <i class="bi bi-plus-lg"></i> Agregar Nueva Presentación
                    </a>
                </div>
            </div>
        </form>

        <div class="card shadow-sm">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th class="ps-4" style="width: 12%;">ID</th>
                            <th style="width: 18%;">ID Producto</th>
                            <th style="width: 30%;">Tamaño / Porción</th>
                            <th style="width: 20%;">Precio de Venta</th>
                            <th class="text-end pe-4" style="width: 20%;">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    @if (Model.ProductVariants != null && Model.ProductVariants.Any())
                    {
                        @foreach (var variant in Model.ProductVariants)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted">@variant.Id</td>
                                <td>
                                    <span class="badge bg-dark px-2.5 py-1.5">
                                        <i class="bi bi-box-seam me-1"></i> @variant.ProductName
                                    </span>
                                </td>
                                <td>
                                    <span class="size-badge fw-bold">
                                        <i class="bi bi-arrows-angle-expand me-1"></i> @variant.Size
                                    </span>
                                </td>
                                <td>
                                    <span class="price-text fw-bold">
                                        $@variant.Price.ToString("F2")
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-page="./Update" asp-route-id="@variant.Id" class="btn btn-warning btn-sm me-2">
                                        <i class="bi bi-pencil"></i> Editar
                                    </a>
                                    <button class="btn btn-danger btn-sm" onclick="deleteVariant(@variant.Id)">
                                        <i class="bi bi-trash"></i> Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="5" class="text-center text-muted py-5">
                                <i class="bi bi-tags display-6 d-block mb-2 text-muted"></i>
                                No se encontraron tamaños ni presentaciones registradas.
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function deleteVariant(id) {
            if (!confirm("¿Estás seguro de que deseas eliminar esta presentación comercial?")) 
                return;

            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;

            fetch(`/ProductVariant/List?handler=Delete&id=${id}`, {
                method: 'POST',
                headers: { 'RequestVerificationToken': token ?? '' }
            })
            .then(r => { if (!r.ok) throw new Error(r.status); return r.json(); })
            .then(result => {
                if (result === true || result.success === true || result === "true") {
                    alert("✅ Presentación eliminada correctamente");
                    location.reload();
                } else {
                    alert("❌ Error al eliminar la presentación");
                }
            })
            .catch(e => alert("Error crítico al procesar la solicitud: " + e.message));
        }
    </script>
}