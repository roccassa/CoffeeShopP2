@page
@model Coffee.WebSite.Pages.ProductVariant.ListModel
@{
    ViewData["Title"] = "Presentaciones de Producto";
}

<div class="page-header">
    <div class="container d-flex align-items-center justify-content-between flex-wrap gap-2">
        <div>
            <h1 class="fw-bold mb-0 fs-4"><i class="bi bi-tags-fill me-2"></i>Presentaciones de Producto</h1>
            <p class="mb-0 opacity-75 small">Gestiona los tamaños y precios de venta al público</p>
        </div>
        <a asp-page="./Create" class="btn-form-save btn">
            <i class="bi bi-plus-circle me-1"></i>Nueva Presentación
        </a>
    </div>
</div>

<div class="container" style="padding-bottom:3rem;">

    <!-- Search -->
    <form method="get" class="mb-4">
        <div class="input-group" style="max-width:420px;">
            <span class="input-group-text" style="background:var(--cream-warm); border-color:var(--soft-gray);">
                <i class="bi bi-search text-muted"></i>
            </span>
            <input type="text" name="searchTerm" value="@Model.SearchTerm"
                   class="form-control" placeholder="Buscar por producto o tamaño…"
                   style="border-color:var(--soft-gray); background:var(--cream);" />
            <button class="btn" style="background:var(--coffee-dark); color:#fff; border:none;">Buscar</button>
        </div>
    </form>

    @if (Model.ProductVariants.Any())
    {
        <div class="form-card p-0" style="overflow:hidden;">
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Producto</th>
                        <th>Tamaño / Porción</th>
                        <th>Precio de Venta</th>
                        <th class="text-end pe-4">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var v in Model.ProductVariants)
                    {
                        <tr>
                            <td class="ps-4">
                                <span class="fw-semibold" style="color:var(--coffee-dark);">@v.ProductName</span>
                            </td>
                            <td>
                                <span class="badge"
                                      style="background:var(--cream-warm);color:var(--coffee-dark);
                                             border:1px solid var(--soft-gray);font-size:0.85rem;padding:0.4rem 0.8rem;">
                                    <i class="bi bi-arrows-angle-expand me-1"></i>@v.Size
                                </span>
                            </td>
                            <td>
                                <span class="fw-bold font-monospace" style="color:var(--coffee-medium); font-size:1rem;">
                                    $@v.Price.ToString("F2")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <a asp-page="./Update" asp-route-id="@v.Id"
                                   class="btn btn-sm me-1"
                                   style="background:var(--cream-warm);border:1px solid var(--soft-gray);color:var(--coffee-dark);">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <button class="btn btn-sm btn-danger"
                                        onclick="deleteVariant(@v.Id, '@v.ProductName?.Replace("'","\\'") — @v.Size')">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="bi bi-tags display-4 d-block mb-3 opacity-50"></i>
            <p class="fw-semibold">No hay presentaciones registradas aún.</p>
            <a asp-page="./Create" class="btn-form-save btn mt-2">
                <i class="bi bi-plus-circle me-1"></i>Agregar primera presentación
            </a>
        </div>
    }
</div>

@section Scripts {
<script>
function deleteVariant(id, label) {
    if (!confirm(`¿Eliminar la presentación "${label}"?`)) return;

    const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value;
    fetch(`/ProductVariant/List?handler=Delete&id=${id}`, {
        method: 'POST',
        headers: { 'RequestVerificationToken': token ?? '' }
    })
    .then(r => r.json())
    .then(ok => {
        if (ok === true || ok?.success === true) location.reload();
        else alert('Error al eliminar la presentación.');
    })
    .catch(e => alert('Error: ' + e.message));
}
</script>
}
