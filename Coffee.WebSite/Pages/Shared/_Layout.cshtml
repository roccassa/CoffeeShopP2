<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - Cafetería Control</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>

<nav class="navbar navbar-expand-lg coffee-navbar">
    <div class="container-fluid px-3">
        <a class="navbar-brand" href="/POS/Index">
            <i class="bi bi-cup-hot-fill me-1"></i> Cafetería Control
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav"
                aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="mainNav">
            <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                <li class="nav-item">
                    <a class="nav-link" href="/POS/Index">
                        <i class="bi bi-grid-fill me-1"></i>Menú
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/Order/List">
                        <i class="bi bi-clock-history me-1"></i>Historial
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/OrderDetail/List">
                        <i class="bi bi-receipt me-1"></i>Tickets
                    </a>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-box-seam me-1"></i>Productos
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="/Category/List"><i class="bi bi-tag me-2"></i>Categorías</a></li>
                        <li><a class="dropdown-item" href="/Product/List"><i class="bi bi-cup me-2"></i>Productos</a></li>
                    </ul>
                </li>
                <li class="nav-item dropdown">
                    <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">
                        <i class="bi bi-people-fill me-1"></i>Admin
                    </a>
                    <ul class="dropdown-menu">
                        <li><a class="dropdown-item" href="/User/List"><i class="bi bi-person-badge me-2"></i>Usuarios</a></li>
                        <li><a class="dropdown-item" href="/Customer/List"><i class="bi bi-person-heart me-2"></i>Clientes</a></li>
                        <li><a class="dropdown-item" href="/Role/List"><i class="bi bi-shield me-2"></i>Roles</a></li>
                        <li><a class="dropdown-item" href="/PaymentMethod/List"><i class="bi bi-credit-card me-2"></i>Métodos de Pago</a></li>
                    </ul>
                </li>
            </ul>

            <div class="d-flex align-items-center gap-2">
                <span class="navbar-text">
                    <i class="bi bi-person-circle me-1"></i>@(Context.Session.GetString("Username") ?? "Empleado")
                </span>
                <a href="/Account/Login" class="btn btn-outline-light btn-sm">
                    <i class="bi bi-box-arrow-right me-1"></i>Salir
                </a>
            </div>
        </div>
    </div>
</nav>

<div class="page-wrapper">
    <main role="main" class="main-body">
        @RenderBody()
    </main>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
