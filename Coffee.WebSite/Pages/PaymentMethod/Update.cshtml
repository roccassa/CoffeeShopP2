@page "{id:int}"
@model Coffee.WebSite.Pages.PaymentMethod.UpdateModel

@{ ViewData["Title"] = "Editar Método de Pago"; }

<div class="container mt-4">
    <h2>Editar Método de Pago</h2>
    <hr />
    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    <div class="row">
        <div class="col-md-6">
            <form method="post">
                <input type="hidden" asp-for="PaymentMethodDto.Id" />
                <div class="mb-3">
                    <label asp-for="PaymentMethodDto.Name" class="form-label">Nombre</label>
                    <input asp-for="PaymentMethodDto.Name" class="form-control" required />
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                    <a asp-page="./List" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>
